[Unit]
Description=Greenhouse Control Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=greenhouse
Group=greenhouse
SupplementaryGroups=dialout i2c gpio
WorkingDirectory=/opt/greenhouse/backend
Environment=GCC_DATA_DIR=/var/lib/greenhouse
Environment=GCC_SIMULATE=false
Environment=GCC_BIND_HOST=0.0.0.0
# Settings written by deploy/install.sh (they override the defaults above)
EnvironmentFile=-/etc/greenhouse/greenhouse.env
ExecStart=/opt/greenhouse/backend/.venv/bin/python -m uvicorn app.main:create_app --factory --host ${GCC_BIND_HOST} --port 8000
Restart=always
RestartSec=5
StateDirectory=greenhouse
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
